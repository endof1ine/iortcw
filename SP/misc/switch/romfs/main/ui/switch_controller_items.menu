// Written by gen_menus.py: the Switch's controller settings, the rows of
// both Controls menus (switch_controls.menu, switch_ingame_controls.menu)
	itemDef {
		name window
		rect 0 2 443 300
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .5 .5 .5 .5
		forecolor 1 1 1 1
		backcolor 0 0 0 .25
		visible 1
		decoration
	}
	itemDef {
		name title
		text "Controller"
		rect 2 4 439 20
		style WINDOW_STYLE_FILLED
		border 1
		bordercolor .1 .1 .1 .2
